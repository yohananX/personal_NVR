# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgresql://nvr_app:CHANGE_ME@localhost:5432/security_nvr

# Browser-facing MediaMTX WebRTC base. No trailing slash.
# Dev PC (no server): leave empty to show placeholder.
# NEXT_PUBLIC_MEDIAMTX_BASE=
# Server ghis (LAN): browsers resolve this directly.
# NEXT_PUBLIC_MEDIAMTX_BASE=http://192.168.0.146:8889
NEXT_PUBLIC_MEDIAMTX_BASE=

# Browser-facing MediaMTX playback base (port 9996). No trailing slash.
# Dev PC: leave empty to show placeholder.
# Server ghis (LAN):
# NEXT_PUBLIC_MEDIAMTX_PLAYBACK_BASE=http://192.168.0.146:9996
NEXT_PUBLIC_MEDIAMTX_PLAYBACK_BASE=

# Server-side only (never NEXT_PUBLIC_). Directory MediaMTX writes to.
# ghis: RECORDINGS_DIR=/srv/mediamtx/recordings
# Dev PC: unset (sync skips) or point at fixtures: RECORDINGS_DIR=./recordings.dev
RECORDINGS_DIR=

# Shared secret for POST /api/sync. Required on ghis, optional on dev.
# Generate: openssl rand -hex 32
SYNC_SECRET=

# Server-side only. MediaMTX control API for dashboard liveness.
# ghis: MEDIAMTX_API_BASE=http://127.0.0.1:9997
# Dev PC: leave empty (cards show UNKNOWN).
MEDIAMTX_API_BASE=
# Only if the control API has auth enabled:
# MEDIAMTX_API_USER=
# MEDIAMTX_API_PASS=

# Session cookie security. LAN-first: HTTP deployments reject `Secure`
# cookies, so this is env-controlled instead of NODE_ENV-based.
# HTTP LAN (current ghis deployment http://192.168.0.146:3000):
#   AUTH_COOKIE_SECURE=false
# When HTTPS is introduced, set:
#   AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SECURE=false
